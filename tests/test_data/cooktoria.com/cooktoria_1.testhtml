age":"en-US","@id":"https://cooktoria.com/cabbage-sauteed-chicken/#primaryimage","url":"https://cooktoria.com/wp-content/uploads/2018/12/Cabbage-and-Chicken-SQ-3.jpg","contentUrl":"https://cooktoria.com/wp-content/uploads/2018/12/Cabbage-and-Chicken-SQ-3.jpg","width":1200,"height":1200},{"@type":"BreadcrumbList","@id":"https://cooktoria.com/cabbage-sauteed-chicken/#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://cooktoria.com/"},{"@type":"ListItem","position":2,"name":"Healthy Recipes","item":"https://cooktoria.com/category/healthy-recipes/"},{"@type":"ListItem","position":3,"name":"Cabbage with Chicken"}]},{"@type":"WebSite","@id":"https://cooktoria.com/#website","url":"https://cooktoria.com/","name":"COOKTORIA","description":"A food blog filled with quick, wholesome, and tasty recipes.","publisher":{"@id":"https://cooktoria.com/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https://cooktoria.com/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https://cooktoria.com/#organization","name":"Cooktoria","url":"https://cooktoria.com/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https://cooktoria.com/#/schema/logo/image/","url":"https://cooktoria.com/wp-content/uploads/2019/04/Tania-Sheff.jpg","contentUrl":"https://cooktoria.com/wp-content/uploads/2019/04/Tania-Sheff.jpg","width":400,"height":400,"caption":"Cooktoria"},"image":{"@id":"https://cooktoria.com/#/schema/logo/image/"},"sameAs":["https://www.facebook.com/cooktoria","https://instagram.com/tania.sheff/","https://www.linkedin.com/pub/tania-sheff/9b/851/b55","https://www.pinterest.com/cooktoria/","https://www.youtube.com/channel/UCxrMynEmDBSW_G0g3i0_-Mw?view_as=subscriber"]},{"@type":"Person","@id":"https://cooktoria.com/#/schema/person/9e4e90619c786c055be8fe9fc7567309","name":"Tania Sheff","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https://cooktoria.com/#/schema/person/image/","url":"https://secure.gravatar.com/avatar/dfe0f78d3109e63eabd43dc80be4af6c5707d5b391ec5c282e236a3b3cd9be71?s=96&d=blank&r=g","contentUrl":"https://secure.gravatar.com/avatar/dfe0f78d3109e63eabd43dc80be4af6c5707d5b391ec5c282e236a3b3cd9be71?s=96&d=blank&r=g","caption":"Tania Sheff"},"sameAs":["https://cooktoria.com/about-me/"],"url":"https://cooktoria.com/author/taniasheff/"},{"@type":"Recipe","name":"Cabbage Sauteed with Chicken","author":{"@id":"https://cooktoria.com/#/schema/person/9e4e90619c786c055be8fe9fc7567309"},"description":"Succulent cabbage sauteed with tender chicken&nbsp;and vegetables. Just a few ingredients and about 15 minutes of active time make up this delicious dinner. This is my #1 Best&nbsp;Recipe yet!","datePublished":"2018-12-01T11:00:10+00:00","image":["https://cooktoria.com/wp-content/uploads/2018/12/Cabbage-and-Chicken-SQ-3.jpg","https://cooktoria.com/wp-content/uploads/2018/12/Cabbage-and-Chicken-SQ-3-500x500.jpg","https://cooktoria.com/wp-content/uploads/2018/12/Cabbage-and-Chicken-SQ-3-500x375.jpg","https://cooktoria.com/wp-content/uploads/2018/12/Cabbage-and-Chicken-SQ-3-480x270.jpg"],"video":{"name":"Cabbage and Chicken","description":"This succulent Cabbage and Chicken is hearty, filling, and so delicious. Just a few ingredients and about 15 minutes of active time make up this delicious dinner. This is my #1 Best Recipe yet!","thumbnailUrl":"https://content.jwplatform.com/thumbs/r4FLuEhs-720.jpg","contentUrl":"https://content.jwplatform.com/videos/r4FLuEhs.mp4","uploadDate":"2018-11-22T04:37:17.000Z","@type":"VideoObject"},"recipeYield":["8","8 servings"],"prepTime":"PT15M","cookTime":"PT60M","totalTime":"PT75M","recipeIngredient":["3 tbsp olive oil","1 1/2 lb boneless chicken thighs, cut into small pieces","1 medium cabbage","2 medium  carrots (shredded)","1 tbsp paprika","2 tbsp. tomato paste","1 cup chicken stock","2/3 tsp. salt (or to taste)","1/4 tsp. pepper (or to taste)","1 tbsp. hot sauce (optional)","2 tbsp. chopped fresh parsley"],"recipeInstructions":[{"@type":"HowToStep","text":"Warm up a large sauté pan over medium-high heat. Add the olive oil and chicken. Fry for 5-7 minutes or until browned.","name":"Warm up a large sauté pan over medium-high heat. Add the olive oil and chicken. Fry for 5-7 minutes or until browned.","url":"https://cooktoria.com/cabbage-sauteed-chicken/#wprm-recipe-5141-step-0-0","image":"https://cooktoria.com/wp-content/uploads/2016/03/chicken-and-cabbage-step-5.jpg"},{"@type":"HowToStep","text":"Meanwhile, slice the cabbage into thin strips, just like you would for coleslaw.","name":"Meanwhile, slice the cabbage into thin strips, just like you would for coleslaw.","url":"https://cooktoria.com/cabbage-sauteed-chicken/#wprm-recipe-5141-step-0-1","image":"https://cooktoria.com/wp-content/uploads/2016/03/chicken-and-cabbage-step.jpg"},{"@type":"HowToStep","text":"Add the paprika and tomato paste to the chicken. Stir, and then sauté for another five minutes.","name":"Add the paprika and tomato paste to the chicken. Stir, and then sauté for another five minutes.","url":"https://cooktoria.com/cabbage-sauteed-chicken/#wprm-recipe-5141-step-0-2","image":"https://cooktoria.com/wp-content/uploads/2016/03/chicken-and-cabbage-step-1.jpg"},{"@type":"HowToStep","text":"Add the cabbage and cook for five more minutes.","name":"Add the cabbage and cook for five more minutes.","url":"https://cooktoria.com/cabbage-sauteed-chicken/#wprm-recipe-5141-step-0-3","image":"https://cooktoria.com/wp-content/uploads/2016/03/chicken-and-cabbage-step-2.jpg"},{"@type":"HowToStep","text":"Add the shredded carrots, chicken stock, salt, and pepper. Stir everything together. Cook without the lid, stirring occasionally, for about 40 minutes, until there is no liquid remaining.","name":"Add the shredded carrots, chicken stock, salt, and pepper. Stir everything together. Cook without the lid, stirring occasionally, for about 40 minutes, until there is no liquid remaining.","url":"https://cooktoria.com/cabbage-sauteed-chicken/#wprm-recipe-5141-step-0-4","image":"https://cooktoria.com/wp-content/uploads/2016/03/chicken-and-cabbage-step-3.jpg"},{"@type":"HowToStep","text":"Add 1 tablespoon of hot sauce, if desired. Garnish with fresh parsley.","name":"Add 1 tablespoon of hot sauce, if desired. Garnish with fresh parsley.","url":"https://cooktoria.com/cabbage-sauteed-chicken/#wprm-recipe-5141-step-0-5"}],"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.62","ratingCount":"669","reviewCount":"9"},"review":[{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"This is really delicious!","author":{"@type":"Person","name":"Lorraine W"},"datePublished":"2025-03-10"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"Very delicious! I love colour so added some red bell pepper. Added Onion to the Sautéed Cabbage and cut back the amount of cabbage to make it more hearty for my hubby. He's not a fan of too many carrots so just did a quarter of these. I stirred in Chopped cilantro and green onions instead of parsley. Very nice indeed. Thank you so much for sharing with us.","author":{"@type":"Person","name":"Sherry Bare"},"datePublished":"2025-02-18"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"Tried this for the first time.  Right good.  I’ll probably try it again with jalapeños and yellow peppers.    Thank you","author":{"@type":"Person","name":"Linda"},"datePublished":"2025-02-10"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"I've made this 5 or 6 times now, and each time the whole family loves it. I make it as written, though once or twice resorted to rotisserie  chicken (adding it later).  Resist the urge to add onion or garlic- not needed!  Quick, healthy, easy and wonderful!","author":{"@type":"Person","name":"Val"},"datePublished":"2025-02-05"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"I live in middle Ga. and we are just now getting into our bitterest part of winter, so I was looking for something warm and comforting.  I came across your recipe last week and decided to make it last night.  I was surprised to find that onions weren't listed as part of the ingredients...As a southern woman, that goes against ever fiber of my being not to include onions, especially with cabbage! lol When I first try a recipe, I like to make it as is, so I can get a true taste of the recipe, not something that I altered.  So I made it, as is, with all of my southern ancestors scolding me for not using onions lol  It was truly delicious!  I did use the velveting process for my chicken, because that is what I always do and it makes for the most juicy and tender pieces of chicken breasts.  To be honest, I didn't even miss the onions but I think I will add them next time just to satisfy my ancestors! lol  Thanks for the recipe, it's a def. keeper!","author":{"@type":"Person","name":"Patti Goodman"},"datePublished":"2025-01-06"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"4"},"reviewBody":"PRETTY GOOD W/ REVISIONS!\r\nI made this recipe as is and tasted it, and it was a bit bland honestly. So I added some chicken Better than Buillon, a cube of Consomate(chicken and tomato broth concentrate), and an extra 1/2 cup of water. I felt like it would better better with the juice on it, sort of stewy/saucy to eat over rice. Then there would be juice to soak on the rice. \r\n   Also, I used chicken breast sliced super thin and soaked the chicken in a salted cornstarch slurry for just a few minutes(makes the chicken suuuuper tender)((once you start doing your chicken this way, you won’t cook it any other way ever again).  Pretty tasty this way.","author":{"@type":"Person","name":"Miranda Flores"},"datePublished":"2024-12-06"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"I made this recipe but cut it in half because there is only two of us.  Hubby said I could make it again.  Quite a compliment from him.  I loved it.","author":{"@type":"Person","name":"Alice"},"datePublished":"2024-11-27"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"Love cabbage and always looking for new ways to incorporate this healthy vegetable into our family's diet.  This did not disappoint and is a keeper!  Paired well with plain white rice.  May try it with half red and half green cabbage next time.","author":{"@type":"Person","name":"Debi"},"datePublished":"2024-10-16"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"This was a delicious use of the cabbage that I have! Thank you for an easy recipe!! I served it over rice and the kids and husband loved it!","author":{"@type":"Person","name":"Raija"},"datePublished":"2024-09-08"}],"recipeCategory":["Main Course"],"recipeCuisine":["ukrainian"],"keywords":"cabbage with chicken","nutrition":{"@type":"NutritionInformation","calories":"286 kcal","carbohydrateContent":"11 g","proteinContent":"17 g","fatContent":"20 g","saturatedFatContent":"5 g","cholesterolContent":"84 mg","sodiumContent":"379 mg","fiberContent":"4 g","sugarContent":"5 g","transFatContent":"0.1 g","unsaturatedFatContent":"14 g","servingSize":"1 serving"},"@id":"https://cooktoria.com/cabbage-sauteed-chicken/#recipe","isPartOf":{"@id":"https://cooktoria.com/cabbage-sauteed-chicken/#article"},"mainEntityOfPage":"https://cooktoria.com/cabbage-sauteed-chicken/"}]}</script>
